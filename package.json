{
  "name": "sl-ops",
  "version": "0.1.1",
  "private": true,
  "description": "运维管理平台",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "lint": "eslint . --cache",
    "oxlint": "oxlint",
    "oxfmt": "oxfmt --check",
    "oxfmt:fix": "oxfmt --write",
    "type-check": "vue-tsc --build",
    "check": "run-p oxlint oxfmt type-check",
    "check:fix": "oxfmt --write && run-p oxlint type-check",
    "knip": "knip",
    "api:transform": "node scripts/transform-openapi-tags.mjs",
    "api:generate": "npm run api:transform && alova gen -f",
    "changeset:add": "changeset add",
    "changeset:version": "changeset version",
    "changeset:commit": "changeset tag"
  },
  "dependencies": {
    "@alova/mock": "catalog:",
    "@vueuse/core": "catalog:",
    "alova": "catalog:",
    "echarts": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-echarts": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@alova/wormhole": "catalog:",
    "@changesets/cli": "catalog:",
    "@iconify-json/carbon": "catalog:",
    "@types/node": "catalog:",
    "@unocss/preset-attributify": "catalog:",
    "@unocss/preset-wind4": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/eslint-config-typescript": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "knip": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.13.1"
}

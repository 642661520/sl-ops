          },
          "memoryUsage": {
            "type": "string",
            "description": "内存 使用率 (%)"
          },
          "diskUsage": {
            "type": "string",
            "description": "磁盘 使用率 (%)"
          }
        },
        "required": ["cpuUsage", "diskUsage", "hostName", "memoryUsage", "serverId"]
      },
      "MetricPoint": {
        "type": "object",
        "description": "监控指标数据点",
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "13位毫秒时间戳"
          },
          "value": {
            "type": "number",
            "description": "指标值"
          }
        }
      },
      "RListMetricPoint": {
        "type": "object",
        "description": "响应信息主体",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "消息状态码"
          },
          "msg": {
            "type": "string",
            "description": "消息内容"
          },
          "data": {
            "type": "array",
            "description": "数据对象",
            "items": {
              "$ref": "#/components/schemas/MetricPoint"
            }
          }
        }
      },
      "RBoolean": {
        "type": "object",
        "description": "响应信息主体",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "消息状态码"
          },
          "msg": {
            "type": "string",
            "description": "消息内容"
          },
          "data": {
            "type": "boolean",
            "description": "数据对象"
          }
        }
      },
      "RLong": {
        "type": "object",
        "description": "响应信息主体",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "消息状态码"
          },
          "msg": {
            "type": "string",
            "description": "消息内容"
          },
          "data": {
            "type": "integer",
            "format": "int64",
            "description": "数据对象"
          }
        }
      },
      "ServiceInfoUpdateBo": {
        "type": "object",
        "description": "服务信息编辑请求",
        "properties": {
          "id": {
            "type": "string",
            "description": "主键ID"
          },
          "serviceName": {
            "type": "string",
            "description": "服务名称"
          },
          "serviceType": {
            "type": "string",
            "description": "服务类型",
            "enum": ["docker", "systemctl", "custom"]
          },
          "description": {
            "type": "string",
            "description": "服务描述"
          },
          "startCommand": {
            "type": "string",
            "description": "自定义启动命令(仅custom类型使用)"
          },
          "stopCommand": {
            "type": "string",
            "description": "自定义停止命令(仅custom类型使用)"
          },
          "restartCommand": {
            "type": "string",
            "description": "自定义重启命令(仅custom类型使用)"
          },
          "statusCommand": {

          "id": {
            "type": "string",
            "description": "主键ID"
          },
          "hostName": {
            "type": "string",
            "description": "主机别名"
          },
          "sshPort": {
            "type": "integer",
            "format": "int32",
            "description": "SSH端口，有效范围 1-65535"
          },
          "sshUsername": {
            "type": "string",
